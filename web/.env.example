# Copy to .env.local for local development. In production, set these in Vercel → Project → Settings → Environment Variables.
# None of these are ever sent to the browser.

# Jupiter Prediction API key (free): https://developers.jup.ag/portal
JUPITER_API_KEY=

# A Solana mainnet RPC URL with your key, e.g. from Helius (free tier is fine): https://www.helius.dev
SOLANA_RPC_URL=

# Largest single fade in USD, enforced by the server. Start small.
CONTRA_MAX_FADE_USD=25

# Optional: once you know the Jupiter prediction program id (see docs/DEPLOY.md), set it to lock the relay to it.
JUPITER_PREDICTION_PROGRAM_ID=

# Public: your site's URL, used for share links and share images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
